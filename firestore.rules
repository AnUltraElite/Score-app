rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function validUsername() {
      return request.resource.data.username is string
        && request.resource.data.username.matches('^[a-z0-9._-]{3,20}$');
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['uid', 'username', 'name', 'bio', 'createdAt', 'updatedAt'])
        && request.resource.data.uid == userId
        && validUsername();
      allow update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['uid', 'username', 'name', 'bio', 'createdAt', 'updatedAt'])
        && request.resource.data.uid == resource.data.uid
        && validUsername();
      allow delete: if false;
    }

    match /usernames/{username} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'username', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == username
        && !exists(/databases/$(database)/documents/usernames/$(username));
      allow update: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'username', 'createdAt'])
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == username;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /matches/{matchId} {
      allow get: if signedIn()
        && (resource.data.ownerId == request.auth.uid || resource.data.visibility == 'public');
      allow list: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.id == matchId;
      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.id == matchId;
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }
  }
}
